{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoforge.com/contracts/family-adapter-registry-snapshot-v1.schema.json",
  "title": "Family 14B Personality Registry Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "generated_at", "registry_revision", "personas"],
  "properties": {
    "schema": {"const": "echo.family-adapter-registry-snapshot/v1"},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "generated_at": {"type": "string", "format": "date-time"},
    "registry_revision": {"type": "string", "minLength": 1},
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "persona_id",
          "requested_model",
          "adapter_id",
          "adapter_artifact_digest",
          "adapter_version",
          "maturity_state",
          "enabled",
          "registry_revision"
        ],
        "properties": {
          "persona_id": {"type": "string", "minLength": 1},
          "requested_model": {"type": "string", "minLength": 1},
          "adapter_id": {"type": "string", "minLength": 1},
          "adapter_artifact_digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
          "adapter_version": {"type": "string", "minLength": 1},
          "maturity_state": {
            "enum": ["UNSUPPORTED", "EXPERIMENTAL", "CONFORMANCE_PENDING", "CERTIFIED", "DEGRADED", "DISABLED"]
          },
          "enabled": {"type": "boolean"},
          "registry_revision": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
