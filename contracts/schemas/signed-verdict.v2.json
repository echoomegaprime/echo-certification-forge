{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cert.echoforge.com/contracts/signed-verdict.v2.json",
  "title": "SignedVerdictV2",
  "type": "object",
  "required": ["payload", "signature_b64", "key_id", "public_key_pem"],
  "properties": {
    "payload": {
      "type": "object",
      "required": ["run_id", "tenant_id", "run_outcome", "release_verdict", "target_identity_digest", "environment_identity_digest", "policy_version", "mandatory_rules_digest", "evidence_merkle_root", "anchor_receipt_id", "signing_key_id", "lifecycle_state", "issued_at", "expires_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "run_outcome": {"enum": ["COMPLETE", "INCONCLUSIVE", "CANCELLED", "INFRA_FAILED"]},
        "release_verdict": {"enum": ["NOT_READY", "CONDITIONALLY_READY", "PRODUCTION_READY"]},
        "target_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "mandatory_rules_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_merkle_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "anchor_receipt_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "signing_key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lifecycle_state": {"enum": ["VALID", "REVOKED", "INVALIDATED", "SUPERSEDED"]},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "signature_b64": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "public_key_pem": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
